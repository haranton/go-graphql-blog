type Post {
  id: ID!
  title: String!
  content: String!
  author: String
  allowComments: Boolean!
  comments: [Comment!]!
}

type Comment {
  id: ID!
  postId: ID!
  parentId: ID
  author: String
  content: String!
  replies: [Comment!]
}

type Query {
    posts: [Post!]!
    post(id: ID!): Post
}

type Mutation {
    createPost(title: String!, content: String!): Post!
    addComment(postId: ID!, parentId: ID, content: String!): Comment!
}

type Subscription {
    newComment(postId: ID!): Comment!
}
